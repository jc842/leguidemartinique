---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import ReviveSlot from '../components/ads/ReviveSlot.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && (!data.lang || data.lang === 'fr'));
allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
const featuredPosts = allPosts.slice(0, 9);

const martiniqueCollections = [
  { title: "Nord Sauvage & Montagne Pelée", code: "UNESCO-VOLCANO-01", desc: "Forêts pluviales primaires classées UNESCO, gorges encaissées de la Falaise, ruines de Saint-Pierre et plages de sable noir.", icon: "🌋", link: "/blog/" },
  { title: "Sud Caraïbe & Anses Paisibles", code: "SOUTH-BEACH-02", desc: "Les Anses-d'Arlet et ses tortues marines, le rocher du Diamant, le sable blanc des Salines et les anses abritées de Sainte-Luce.", icon: "🏖️", link: "/blog/" },
  { title: "Caravelle & Côte Atlantique", code: "ATLANTIC-SURF-03", desc: "La presqu'île de la Caravelle, les vagues réputées de Tartane, les ruines du Château Dubuc et la mangrove protégée.", icon: "🏄", link: "/blog/" },
  { title: "Route des Rhums Agricoles AOC", code: "RHUM-AOC-04", desc: "L'unique appellation d'origine contrôlée au monde : Habitation Clément, Neisson, Depaz et Saint-James pur jus de canne.", icon: "🥃", link: "/blog/" },
  { title: "Fort-de-France & Patrimoine", code: "CITY-CULTURE-05", desc: "La majestueuse baie des Flamands, le marché aux épices coloré, la bibliothèque Schœlcher et l'architecture coloniale.", icon: "🏛️", link: "/blog/" },
  { title: "Saveurs & Traditions Créoles", code: "KREYOL-TASTE-06", desc: "Le Tour des Yoles Rondes, le féroce d'avocat épicé, le matoutou de crabes pascal et les douceurs au coco frais.", icon: "⛵", link: "/blog/" },
];
---

<Layout title="Le Guide Martinique — Communes, Anses, Patrimoine & Distilleries AOC">
  <!-- Hero Section Lexington Trendspotter Style -->
  <section class="relative overflow-hidden pt-12 pb-16 lg:py-24 border-b border-stone-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200/80 text-amber-900 text-xs font-mono font-medium tracking-wide uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-amber-600"></span>
          <span>34 Communes • Madinina • Patrimoine UNESCO • Guide Indépendant</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-heading font-black text-stone-900 tracking-tight leading-[1.08] mb-6">
          LE GUIDE ESSENTIEL DE LA MARTINIQUE, <span class="underline decoration-amber-500 decoration-wavy underline-offset-8">ENTRE NATURE & CULTURE</span>.
        </h1>

        <p class="text-lg sm:text-xl text-stone-600 leading-relaxed font-normal mb-8">
          Le répertoire éditorial de référence : 34 communes décryptées, sentiers volcaniques de la Montagne Pelée, anses secrètes du Sud, distilleries de rhum agricole AOC et patrimoine créole vivant.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="/blog/" class="px-6 py-3.5 rounded-lg bg-stone-900 text-white font-medium text-sm hover:bg-stone-800 transition-colors shadow-sm">
            Consulter les 200 Dossiers &rarr;
          </a>
          <a href="#collections" class="px-6 py-3.5 rounded-lg border border-stone-300 text-stone-700 font-medium text-sm hover:bg-stone-50 transition-colors">
            Explorer les Régions
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- International Editions Hub (i18n) -->
  <section class="border-b border-stone-200 bg-stone-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/en/" class="group p-5 rounded-xl bg-white border border-stone-200 hover:border-amber-500 transition-all flex items-center justify-between shadow-xs">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800">English Edition</span>
              <span class="text-[10px] bg-stone-100 text-stone-600 px-2 py-0.5 rounded border border-stone-200">EN</span>
            </div>
            <h3 class="text-base font-bold text-stone-900 group-hover:text-amber-800 transition-colors">
              Martinique Island Travel Guide: 34 Communes, Mount Pelée & Southern Coves
            </h3>
            <p class="text-xs text-stone-500 mt-1">
              Comprehensive traveler manual, UNESCO rainforest trails, and AOC rum route.
            </p>
          </div>
          <span class="text-xl text-amber-700 group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>

        <a href="/es/" class="group p-5 rounded-xl bg-white border border-stone-200 hover:border-amber-500 transition-all flex items-center justify-between shadow-xs">
          <div>
            <div class="flex items-center space-x-2 mb-1">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-amber-800">Edición en Español</span>
              <span class="text-[10px] bg-stone-100 text-stone-600 px-2 py-0.5 rounded border border-stone-200">ES</span>
            </div>
            <h3 class="text-base font-bold text-stone-900 group-hover:text-amber-800 transition-colors">
              Guía Completa de Martinica: Playas del Sur, Volcán Pelée y Rutas Criollas
            </h3>
            <p class="text-xs text-stone-500 mt-1">
              Información detallada para explorar las 34 comunas, calas secretas y destilerías.
            </p>
          </div>
          <span class="text-xl text-amber-700 group-hover:translate-x-1 transition-transform ml-4">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Collections Thématiques (Trendspotter Grid) -->
  <section id="collections" class="py-16 border-b border-stone-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-amber-800 font-bold block mb-2">Répertoire Thématique</span>
          <h2 class="text-2xl sm:text-4xl font-heading font-black text-stone-900 tracking-tight">
            6 Pôles d'Investigation en Martinique
          </h2>
        </div>
        <p class="text-sm text-stone-500 max-w-md mt-4 md:mt-0">
          Chaque commune, chaque sentier côtier et chaque maison de rhum minutieusement documentés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {martiniqueCollections.map(item => (
          <div class="p-6 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-white hover:border-amber-500 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl">{item.icon}</span>
                <span class="text-[11px] font-mono font-medium text-stone-400 bg-white px-2 py-0.5 rounded border border-stone-200">{item.code}</span>
              </div>
              <h3 class="text-lg font-bold text-stone-900 mb-2">{item.title}</h3>
              <p class="text-xs text-stone-600 leading-relaxed">{item.desc}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-stone-200 flex items-center justify-between text-xs font-semibold text-amber-800">
              <a href={item.link} class="hover:underline">Consulter les guides &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Derniers Articles & Guides Pratiques -->
  <section class="py-16 bg-stone-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 border-b border-stone-200 pb-4">
        <div>
          <h2 class="text-2xl font-black text-stone-900 tracking-tight">Guides & Analyses Récents</h2>
          <p class="text-xs text-stone-500 mt-1">Les dernières fiches pratiques et enquêtes sur l'île aux fleurs.</p>
        </div>
        <a href="/blog/" class="text-xs font-bold text-amber-800 hover:text-amber-900 transition-colors uppercase tracking-wider">
          Tous les articles ({allPosts.length}) &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredPosts.map(post => (
          <article class="p-5 rounded-xl bg-white border border-stone-200 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <span class="text-[11px] font-mono font-semibold uppercase text-amber-800 block mb-2">{post.data.category || 'Guide'}</span>
              <h3 class="text-base font-bold text-stone-900 hover:text-amber-800 transition-colors line-clamp-2 mb-2">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="text-xs text-stone-500 line-clamp-3 leading-relaxed mb-4">{post.data.description}</p>
            </div>
            <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
              <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
              <a href={`/blog/${post.id}/`} class="text-amber-800 font-semibold hover:underline">Lire la suite &rarr;</a>
            </div>
          </article>
        ))}
      </div>

      <!-- Revive In-Content Slot -->
      {siteConfig.revive?.zones?.inContent && (
        <div class="my-10 flex justify-center">
          <ReviveSlot format={siteConfig.revive.zones.inContent.format} zoneId={siteConfig.revive.zones.inContent.zoneId} />
        </div>
      )}
    </div>
  </section>
</Layout>
